generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  google
  kakao
  naver
}

enum UserRole {
  user
  admin
}

enum RoomMemberRole {
  creator
  member
}

enum BibleScope {
  OLD_TESTAMENT @map("구약")
  NEW_TESTAMENT @map("신약")
  ALL           @map("전체")
}

enum BiblePlanType {
  SEQUENTIAL    @map("정주행")
  CHRONOLOGICAL @map("연대기순")
  PARALLEL      @map("병행")
  MCHEYNE       @map("맥체인")
}

enum BibleReflectionReactionType {
  LIKE
  HEART
  PRAY
}

enum FeedbackStatus {
  NEW
  READ
  REPLIED
  CLOSED
}

model User {
  id                    String       @id @default(cuid())
  provider              AuthProvider
  providerUserId        String
  nickname              String?      @unique
  role                  UserRole     @default(user)
  bibleCopyrightAllowed Boolean      @default(false)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  deletedAt             DateTime?

  createdRooms      PrayerRoom[]       @relation("RoomCreator")
  memberships       RoomMember[]
  prayerPosts       PrayerPost[]
  prayerPostPrayers PrayerPostPrayer[]

  createdBibleRooms        BibleRoom[]               @relation("BibleRoomCreator")
  bibleMemberships         BibleRoomMember[]
  bibleReflections         BibleReflection[]
  bibleReflectionReactions BibleReflectionReaction[]
  bibleProgress            BibleProgress[]
  feedbacks                Feedback[]
  prayNews                 PrayNews[]

  @@unique([provider, providerUserId])
  @@index([deletedAt])
}

model PrayerRoom {
  id            String    @id @default(cuid())
  title         String
  description   String
  passwordHash  String
  creatorUserId String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  creator User         @relation("RoomCreator", fields: [creatorUserId], references: [id])
  members RoomMember[]
  posts   PrayerPost[]

  @@index([creatorUserId])
  @@index([deletedAt])
}

model RoomMember {
  id       String         @id @default(cuid())
  roomId   String
  userId   String
  role     RoomMemberRole @default(member)
  joinedAt DateTime       @default(now())
  kickedAt DateTime?
  leftAt   DateTime?

  room PrayerRoom @relation(fields: [roomId], references: [id])
  user User       @relation(fields: [userId], references: [id])

  @@unique([roomId, userId])
  @@index([userId])
  @@index([roomId])
}

model PrayerPost {
  id         String    @id @default(cuid())
  roomId     String
  userId     String
  content    String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  answeredAt DateTime?
  deletedAt  DateTime?

  room    PrayerRoom         @relation(fields: [roomId], references: [id])
  user    User               @relation(fields: [userId], references: [id])
  prayers PrayerPostPrayer[]

  @@index([roomId, createdAt])
  @@index([userId])
  @@index([deletedAt])
}

model PrayerPostPrayer {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post PrayerPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model PrayNews {
  id           String    @id @default(cuid())
  title        String
  content      String
  imageUrl     String?
  authorUserId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  author User? @relation(fields: [authorUserId], references: [id])

  @@index([authorUserId])
  @@index([createdAt])
  @@index([deletedAt])
}

model BibleVerse {
  id         String @id @default(cuid())
  bookNumber Int
  bookCode   String
  bookName   String
  chapter    Int
  verse      Int
  content    Json

  @@unique([bookCode, chapter, verse])
  @@index([bookCode])
  @@index([bookNumber, chapter, verse])
}

model BibleRoom {
  id             String        @id @default(cuid())
  title          String
  description    String
  passwordHash   String
  scope          BibleScope
  durationMonths Int
  excludeSunday  Boolean       @default(false)
  planType       BiblePlanType @default(SEQUENTIAL)
  creatorUserId  String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  creator     User              @relation("BibleRoomCreator", fields: [creatorUserId], references: [id])
  members     BibleRoomMember[]
  plans       BiblePlan[]
  reflections BibleReflection[]
  progress    BibleProgress[]

  @@index([creatorUserId])
  @@index([deletedAt])
}

model BibleRoomMember {
  id       String         @id @default(cuid())
  roomId   String
  userId   String
  role     RoomMemberRole @default(member)
  joinedAt DateTime       @default(now())
  kickedAt DateTime?
  leftAt   DateTime?

  room BibleRoom @relation(fields: [roomId], references: [id])
  user User      @relation(fields: [userId], references: [id])

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
  @@index([joinedAt])
}

model BiblePlan {
  id           String   @id @default(cuid())
  roomId       String
  readingDate  DateTime
  bookCode     String
  startChapter Int
  endChapter   Int

  room BibleRoom @relation(fields: [roomId], references: [id])

  @@unique([roomId, readingDate, bookCode, startChapter, endChapter])
  @@index([roomId, readingDate])
  @@index([bookCode, startChapter, endChapter])
}

model BibleReflection {
  id        String    @id @default(cuid())
  roomId    String
  userId    String
  bookCode  String
  chapter   Int
  verse     Int
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  room      BibleRoom                 @relation(fields: [roomId], references: [id])
  user      User                      @relation(fields: [userId], references: [id])
  reactions BibleReflectionReaction[]

  @@index([roomId, createdAt])
  @@index([roomId, bookCode, chapter, verse])
  @@index([userId])
  @@index([deletedAt])
}

model BibleReflectionReaction {
  id           String                      @id @default(cuid())
  reflectionId String
  userId       String
  type         BibleReflectionReactionType
  createdAt    DateTime                    @default(now())

  reflection BibleReflection @relation(fields: [reflectionId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id])

  @@unique([reflectionId, userId, type])
  @@index([reflectionId])
  @@index([userId])
  @@index([type])
}

model BibleProgress {
  id          String   @id @default(cuid())
  roomId      String
  userId      String
  readingDate DateTime
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  room BibleRoom @relation(fields: [roomId], references: [id])
  user User      @relation(fields: [userId], references: [id])

  @@unique([roomId, userId, readingDate])
  @@index([roomId, readingDate])
  @@index([userId])
}

model BibleTranslationSetting {
  code              String   @id
  label             String
  isVisible         Boolean  @default(true)
  requiresCopyright Boolean  @default(false)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Feedback {
  id             String         @id @default(cuid())
  feedbackNumber Int            @unique @default(autoincrement())
  userId         String
  title          String
  content        String
  replyEmail     String?
  status         FeedbackStatus @default(NEW)
  adminMemo      String?
  emailTo        String         @default("wepray.support@gmail.com")
  emailSentAt    DateTime?
  emailMessageId String?
  emailError     String?
  readAt         DateTime?
  repliedAt      DateTime?
  closedAt       DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([status, createdAt])
  @@index([status, closedAt])
  @@index([userId, createdAt])
}
